{
  \"version\": 1,
  \"exportedAt\": \"{{EXPORTED_AT}}\",
  \"commandOverrides\": [
    { \"localeIdentifier\": \"en-US\", \"commandID\": \"scrollDown\", \"aliases\": [\"scroll down\", \"page down\"] }
