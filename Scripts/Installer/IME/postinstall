#!/bin/bash
set -euo pipefail

IME_APP="/Library/Input Methods/AetherIME.app"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
SOURCE_ENTRY='{ "Bundle ID" = "com.sevenfei.inputmethod.aether"; InputSourceKind = "Keyboard Input Method"; }'

CONSOLE_USER="$(stat -f%Su /dev/console || true)"
USER_IME_APP=""
if [[ -n "${CONSOLE_USER}" && "${CONSOLE_USER}" != "root" ]]; then
  USER_IME_APP="/Users/${CONSOLE_USER}/Library/Input Methods/AetherIME.app"
fi

# pkgbuild may relocate app bundles into user's Input Methods.
# Normalize to system-level location for consistent discoverability.
if [[ ! -d "${IME_APP}" && -n "${USER_IME_APP}" && -d "${USER_IME_APP}" ]]; then
  /bin/mkdir -p "/Library/Input Methods"
  /usr/bin/ditto "${USER_IME_APP}" "${IME_APP}" || true
  /bin/rm -rf "${USER_IME_APP}" || true
fi

if [[ -d "${IME_APP}" ]]; then
  /usr/sbin/chown -R root:wheel "${IME_APP}" || true
  /bin/chmod -R go-w "${IME_APP}" || true
  "${LSREGISTER}" -f -R -trusted "${IME_APP}" || true
fi

if [[ -n "${CONSOLE_USER}" && "${CONSOLE_USER}" != "root" ]]; then
  USER_UID="$(id -u "${CONSOLE_USER}" 2>/dev/null || true)"
  if [[ -n "${USER_UID}" ]]; then
    launchctl asuser "${USER_UID}" "${LSREGISTER}" -f -R -trusted "${IME_APP}" || true
    launchctl asuser "${USER_UID}" /usr/bin/defaults read com.apple.HIToolbox AppleInputSourceHistory 2>/dev/null | /usr/bin/grep -q "com.sevenfei.inputmethod.aether" || \
      launchctl asuser "${USER_UID}" /usr/bin/defaults write com.apple.HIToolbox AppleInputSourceHistory -array-add "${SOURCE_ENTRY}" || true
    launchctl asuser "${USER_UID}" /usr/bin/defaults read com.apple.HIToolbox AppleEnabledInputSources 2>/dev/null | /usr/bin/grep -q "com.sevenfei.inputmethod.aether" || \
      launchctl asuser "${USER_UID}" /usr/bin/defaults write com.apple.HIToolbox AppleEnabledInputSources -array-add "${SOURCE_ENTRY}" || true
    launchctl asuser "${USER_UID}" /usr/bin/defaults write com.apple.HIToolbox AppleSelectedInputSources -array "${SOURCE_ENTRY}" || true
    launchctl asuser "${USER_UID}" /usr/bin/killall cfprefsd || true
    launchctl asuser "${USER_UID}" /usr/bin/killall TextInputMenuAgent || true
  fi
fi

exit 0
