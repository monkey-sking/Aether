#ifndef AetherDriver_h
#define AetherDriver_h

#include <HIDDriverKit/IOUserHIDEventDriver.iig>

// Class Definition for the Virtual HID Driver
class AetherDriver : public IOUserHIDEventDriver
{
public:
    using super = IOUserHIDEventDriver;

    virtual bool init() override;
    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;
    virtual void free() override;

    // Handle incoming messages from the User Space App
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient ** userClient) override;
};

#endif /* AetherDriver_h */
